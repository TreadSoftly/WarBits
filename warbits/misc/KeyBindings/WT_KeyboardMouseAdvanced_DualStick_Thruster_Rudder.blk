  params{

    // ------------------------------------------------------------------
    // == Params from FIRST (Keyboard/Mouse) FILE (kept as-is) ==
    // ------------------------------------------------------------------
    USEROPT_ATGM_AIM_SENS_HELICOPTER:i=100
    USEROPT_ATGM_AIM_ZOOM_SENS_HELICOPTER:i=10
    USEROPT_FIX_GUN_IN_MOUSE_LOOK:b=no
    USEROPT_FREE_CAMERA_ZOOM_SPEED:i=50
    USEROPT_GUNNER_VIEW_ZOOM_SENS:i=50
    USEROPT_INSTRUCTOR_GROUND_AVOIDANCE:b=no
    USEROPT_INVERTCAMERAY:i=0
    USEROPT_INVERTY_HELICOPTER:b=no
    USEROPT_INVERTY_HELICOPTER_GUNNER:b=no
    USEROPT_INVERTY_SHIP:b=no
    USEROPT_INVERTY_SPECTATOR:b=no
    USEROPT_INVERTY_SUBMARINE:b=no
    USEROPT_JOYFX:b=yes
    USEROPT_MOUSE_USAGE_NO_AIM:i=1
    USEROPT_SHIP_COMBINE_PRI_SEC_TRIGGERS:b=yes
    USEROPT_SINGLE_SHOT_BY_TURRET:b=no
    USEROPT_WHEEL_CONTROL_SHIP:b=no

    // ------------------------------------------------------------------
    // == Additional or new lines from SECOND FILE (Joysticks) ==
    //    (only those that don’t conflict or are brand-new)
    // ------------------------------------------------------------------
    USEROPT_AILERONS_MULTIPLIER:i=77
    // The second file also had USEROPT_ATGM_AIM_SENS_HELICOPTER=100,
    // but that matches the first, so no conflict.
    // The second file sets USEROPT_FIX_GUN_IN_MOUSE_LOOK:b=yes,
    // but we kept the first's "b=no". Change if you prefer yes.

    USEROPT_GUNNER_VIEW_ZOOM_SENS:i=65
    // The first had :i=50. We keep the first’s 50 if you want keyboard
    // values to stay. (Change to 65 if you want the new value.)

    USEROPT_INSTRUCTOR_ENABLED:b=no
    // New line from the second file.

    // The second file said USEROPT_JOYFX:b=no, but we keep the first’s
    // "b=yes" to preserve original keyboard/mouse setting.
    // Change it to 'no' if you want no FFB with joystick.

    USEROPT_MOUSE_SENSE:i=43
    USEROPT_MOUSE_USAGE:i=2
    USEROPT_RUDDER_MULTIPLIER:i=63
    USEROPT_ZOOM_SENSE:i=53
    trackIrAsHeadInTPS:b=yes
    mouseJoystick:b=yes
  }

